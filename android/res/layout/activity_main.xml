<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/voice_folder_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_folder_path_fmt"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btn_rescan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rescan_voices"
            android:contentDescription="@string/rescan_voices" />

        <Button
            android:id="@+id/btn_design"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/design_voice"
            android:contentDescription="@string/design_voice" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_tts_settings"
            android:contentDescription="@string/open_tts_settings" />

        <Button
            android:id="@+id/btn_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_storage_access"
            android:contentDescription="@string/grant_storage_access" />

        <Button
            android:id="@+id/btn_how_to_nz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/how_to_pick_en_nz_title"
            android:contentDescription="@string/how_to_pick_en_nz_title" />

        <Button
            android:id="@+id/btn_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_title"
            android:contentDescription="@string/about_title" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>
</ScrollView>
